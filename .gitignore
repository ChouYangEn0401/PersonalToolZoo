## Project Settings
# 忽略所有以 DONT_GIT_ 开头的文件
DONT_GIT_*

# Byte-compiled files
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment directories
venv/
env/
.venv/
.env/
.env

# PyCharm project files
.idea/

# Distribution / packaging
build/
dist/
*.egg-info/

# Python-specific files
*.log
*.pot

# C extensions
*.so

# Test and coverage
.coverage
*.coveragerc
nosetests.xml
coverage.xml
*.hypothesis/

# PyInstaller
# 各工具不再自己放 .spec，全 repo 只有 scripts/tool.spec 這一份，必須進版控
*.spec
!scripts/tool.spec

# mypy
.mypy_cache/

# jupyter notebooks checkpoints
.ipynb_checkpoints/

# VS Code settings (if you're using VS Code alongside PyCharm)
.vscode/

# Claude Code：.claude/skills 進版控，個人設定不進
.claude/settings.local.json

# Windows / OneDrive
desktop.ini
Thumbs.db
